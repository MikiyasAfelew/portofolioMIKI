# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production | testing
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./portfolio_dev.db
# Production (PostgreSQL on Neon/Supabase/Railway):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_ECHO=false

# ── Docker compose ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Redis (optional — in-memory fallback used if not set) ────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Admin account (used only for seeding — password stored hashed in DB) ─────
ADMIN_EMAIL=heri21miki@gmail.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://mikiyasafelew.com,https://www.mikiyasafelew.com

# ── Email notifications ───────────────────────────────────────────────────────
# Option A — Resend (recommended, free tier: 3000 emails/month)
RESEND_API_KEY=re_CHANGE_ME

# Option B — SMTP (Gmail, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=noreply@yourportfolio.com
# SMTP_FROM_NAME=Mikiyas Portfolio

CONTACT_NOTIFY_EMAIL=heri21miki@gmail.com

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ── GitHub sync ───────────────────────────────────────────────────────────────
GITHUB_USERNAME=MikiyasAfelew
# Personal access token with read:public_repo scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_CHANGE_ME

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CONTACT_PER_HOUR=3
RATE_LIMIT_LOGIN_PER_MINUTE=5
LOGIN_LOCKOUT_THRESHOLD=10

# ── Spam protection ───────────────────────────────────────────────────────────
# Cloudflare Turnstile (optional) — get at: https://dash.cloudflare.com
TURNSTILE_SECRET_KEY=CHANGE_ME_or_leave_empty_to_disable

# ── Analytics salt (for IP hashing) ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
ANALYTICS_SALT=CHANGE_ME_random_hex_32_chars
